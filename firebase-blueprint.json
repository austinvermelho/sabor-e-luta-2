{
  "entities": {
    "Establishment": {
      "title": "Establishment",
      "description": "Mapeamento dos espaços da gastronomia progressista e agroecologia.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "address": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "category", "city", "state", "address", "latitude", "longitude", "description", "status"]
    },
    "Volunteer": {
      "title": "Volunteer",
      "description": "Cadastro de voluntários da plataforma.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "whatsapp": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "availability": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "whatsapp", "city", "state", "status"]
    },
    "CheckIn": {
      "title": "CheckIn",
      "description": "Registro de visitas e carimbos no Passaporte Sabor & Luta.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "establishmentId": { "type": "string" },
        "visitDate": { "type": "string" },
        "experienceNote": { "type": "string" },
        "photoUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "establishmentId", "visitDate", "experienceNote", "createdAt"]
    }
  },
  "firestore": {
    "/establishments/{establishmentId}": {
      "schema": { "$ref": "#/entities/Establishment" },
      "description": "Coleção de estabelecimentos do Sabor & Luta."
    },
    "/volunteers/{volunteerId}": {
      "schema": { "$ref": "#/entities/Volunteer" },
      "description": "Coleção de voluntários do Sabor & Luta."
    },
    "/checkins/{checkinId}": {
      "schema": { "$ref": "#/entities/CheckIn" },
      "description": "Coleção de check-ins e registros de visitas no passaporte."
    }
  }
}

